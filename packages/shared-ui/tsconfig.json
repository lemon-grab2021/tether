{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "types": ["react", "react-dom"],
    "lib": ["ES2021", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}