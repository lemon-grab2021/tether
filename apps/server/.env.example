# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tether

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=tether
MINIO_USE_SSL=false

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change
JWT_REFRESH_SECRET=dev-refresh-secret-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
