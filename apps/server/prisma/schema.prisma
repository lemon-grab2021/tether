// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION & USERS
// ============================================
enum LinkRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  username            String    @unique
  displayName         String
  passwordHash        String
  avatarUrl           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletionRequestedAt DateTime?
  scheduledDeletionAt DateTime?
  deletedAt           DateTime?

  circleMembers CircleMember[]
  messages      Message[]
  reports       Report[]
  auditLogs     AuditLog[]
  uploads       FileUpload[]
  session       Session[]

  sentLinkRequests     LinkRequest[] @relation("LinkRequestSender")
  receivedLinkRequests LinkRequest[] @relation("LinkRequestReceiver")

  directConversatioAsSender   DirectConversation[] @relation("DirectConversationUserOne")
  directConversatioAsReceiver DirectConversation[] @relation("DirectConversationUserTwo")
  sentDirectMessages          DirectMessage[]      @relation("DirectMessageSender")
}

// ============================================
// LINKS & CONNECTIONS
// ============================================
model LinkRequest {
  id          Int               @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  status      LinkRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  sender   User @relation("LinkRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("LinkRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
}

// ============================================
// SESSION
// ============================================
model Session {
  id               String    @id @default(cuid())
  userId           Int
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ============================================
// DIRECT MESSAGES
// ============================================

model DirectConversation {
  id            Int       @id @default(autoincrement())
  userOneId     Int
  userTwoId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime? @default(now())

  userOneLastReadAt DateTime?
  userTwoLastReadAt DateTime?

  // soft delete
  userOneDeletedAt DateTime?
  userTwoDeletedAt DateTime?

  // permanently delete after 30 days
  userOnePurgedAt DateTime?
  userTwoPurgedAt DateTime?

  userOne User @relation("DirectConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("DirectConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  messages DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([userOneDeletedAt])
  @@index([userTwoDeletedAt])
  @@index([userOnePurgedAt])
  @@index([userTwoPurgedAt])
  @@index([lastMessageAt])
}

model DirectMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String?
  mediaUrl       String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  editedAt       DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // For efficient querying
  @@index([senderId]) // For efficient querying
}

// ============================================
// CIRCLES 
// ============================================

model Circle {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isPrivate   Boolean  @default(true)
  inviteCode  String?  @unique // a simple invite system
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  CircleMember[]
  messages Message[]
}

enum MemberRole {
  OWNER
  MODERATOR
  MEMBER
}

model CircleMember {
  id       Int        @id @default(autoincrement())
  userId   Int
  circleId Int
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  // soft delete per member
  chatDeletedAt DateTime?

  purgedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
  @@index([userId])
  @@index([circleId, role])
  @@index([chatDeletedAt])
  @@index([purgedAt])
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id        Int       @id @default(autoincrement())
  circleId  Int
  senderId  Int
  body      String?
  mediaUrl  String?
  createdAt DateTime  @default(now()) //Soft Delete
  deletedAt DateTime?
  editedAt  DateTime?

  circle  Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id])
  reports Report[]

  @@index([circleId, createdAt]) // For pagination
  @@index([circleId, deletedAt]) // For filtering deleted messages
}

// ============================================
// MODERATION 
// ============================================

model Report {
  id         Int          @id @default(autoincrement())
  messageId  Int
  reporterId Int
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

model AuditLog {
  id Int @id @default(autoincrement())

  actorId    Int
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  hash      String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action, createdAt])
  @@index([entityType])
  @@index([hash])
}

model MerkleRoot {
  id        Int      @id @default(autoincrement())
  rootHash  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum FileUploadStatus {
  PENDING_UPLOAD
  UPLOADED
  SCANNING
  CLEAN
  INFECTED
  FAILED
}

model FileUpload {
  id           Int              @id @default(autoincrement())
  uploaderId   Int
  objectKey    String           @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  status       FileUploadStatus @default(PENDING_UPLOAD)
  createdAt    DateTime         @default(now())

  scannedAt     DateTime?
  rejectedAt    DateTime?
  scanResult    String?
  scanSignature String?

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId, status])
}
